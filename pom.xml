<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>nl.rijksoverheid.moz</groupId>
    <artifactId>profiel-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.38.2</quarkus.platform.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Security-override: quarkus-bom 3.38.1 pint jackson-databind op 2.22.0, dat twee
                 Dependabot-alerts heeft (@JsonView-bypass bij @JsonUnwrapped, en case-insensitive
                 deserialisatie die @JsonIgnoreProperties omzeilt), beide gefixt in 2.22.1.
                 jackson-bom i.p.v. een losse databind-pin: databind 2.22.1 vraagt zelf
                 jackson-core 2.22.1, dus een losse databind-pin zou databind 2.22.1 met de
                 jackson-core 2.22.0 van de quarkus-bom combineren — een combinatie die Jackson
                 zelf nooit uitbrengt of test. jackson-bom lijnt core/databind/annotations en alle
                 jackson-datatype-*/jackson-module-* in één entry uit. VERWIJDEREN zodra de
                 quarkus-bom zelf jackson-databind >= 2.22.1 beheert.

                 Dit is een import-scope BOM: positie doet er hier wél toe, dus moet vóór de
                 quarkus-bom import staan (first-wins). Dat geldt niet voor een gewone (niet-import)
                 dependencyManagement-entry — die wint altijd van een geïmporteerde BOM, ongeacht
                 positie. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.22.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Pin swagger-parser to 2.1.40 as required by quarkus-openapi-generator.
                 The Atlassian swagger-request-validator brings in 2.1.22 which is too old and lacks setResolveResponses. -->
            <dependency>
                <groupId>io.swagger.parser.v3</groupId>
                <artifactId>swagger-parser</artifactId>
                <version>2.1.46</version>
            </dependency>
            <!-- Security-override: de quarkus-bom beheert httpclient5 op 5.6.1, dat bij een
                 onbekende Content-Encoding in de response de connectie niet teruggeeft aan de
                 pool; gefixt in 5.6.3. In deze boom komt httpclient5 alleen test-scope binnen,
                 via Pact. httpclient5-fluent is niet zelf kwetsbaar maar wordt meegepind zodat
                 beide artefacten uit dezelfde release komen. VERWIJDEREN zodra de quarkus-bom
                 zelf httpclient5 >= 5.6.3 beheert; t/m 3.39.0.CR1 is dat nog 5.6.1. -->
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5</artifactId>
                <version>5.6.4</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents.client5</groupId>
                <artifactId>httpclient5-fluent</artifactId>
                <version>5.6.4</version>
            </dependency>
            <!-- Security-pins voor test-scope transitives (via Pact) die niet door de quarkus-bom
                 beheerd worden en die Dependabot niet zelf kan updaten. -->
            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-core</artifactId>
                <version>3.3.2</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-configuration2</artifactId>
                <version>2.15.1</version>
            </dependency>
            <dependency>
                <groupId>org.mozilla</groupId>
                <artifactId>rhino</artifactId>
                <version>1.9.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
