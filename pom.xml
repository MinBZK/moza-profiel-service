        <!-- Quarkus-extensie i.p.v. de kale hibernate-validator: de generator zet
             bean-validation-annotaties op de DTO's en deze extensie levert de
             runtime-provider die ze op JAX-RS-parameters afdwingt. Versie wordt
             door de quarkus-bom beheerd. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-kubernetes-config</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jacoco</artifactId>
