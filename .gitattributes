# Normalize text files to LF in the repo and working tree.
# Overrides any local core.autocrlf so line endings stay LF.
* text=auto eol=lf

# Windows wrappers are stored as CRLF and never converted. Dependabot commits via the
# GitHub API, which skips .gitattributes; with conversion the stored blob and the
# checkout drift apart and the file shows as modified after every checkout.
*.bat -text
*.cmd -text
